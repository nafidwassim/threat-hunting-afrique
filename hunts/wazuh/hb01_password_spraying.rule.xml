<!--
  HB-01 (variante règle) - rafale de tentatives sur comptes inexistants depuis une même IP.
  Se base sur la règle native 5710 (sshd : tentative sur un utilisateur inexistant).
  STATUT : brouillon NON testé ; limite connue : compte les événements, pas les comptes distincts -> la requête OpenSearch
  (hb01_password_spraying.opensearch.json) fait foi pour la logique "comptes distincts".
-->
<group name="local,threat_hunting,hb01,">
  <rule id="100100" level="10" frequency="8" timeframe="600">
    <if_matched_sid>5710</if_matched_sid>
    <same_srcip />
    <description>HB-01 : au moins 8 tentatives sur comptes inexistants depuis une même IP en 10 minutes (password spraying)</description>
    <mitre><id>T1110.003</id></mitre>
  </rule>
</group>
